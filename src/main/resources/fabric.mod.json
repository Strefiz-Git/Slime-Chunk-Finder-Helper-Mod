{
  "schemaVersion": 1,
  "id": "slimechunkhud",
  "version": "1.0.0",
  "name": "Slime Chunk Finder Helper Mod",
  "description": "Client-side HUD + green chunk-border overlay for slime chunks (Fabric)",
  "authors": [
    "Strefiz"
  ],
  "contact": {},
  "license": "MIT",
  "icon": "assets/slimechunkhud/icon.png",

  "environment": "*",
  "entrypoints": {
    "main": [
      "com.strefiz.slimechunkhud.SlimeChunkServerMod"
    ],
    "client": [
      "com.strefiz.slimechunkhud.SlimeChunkHudMod"
    ],
    "modmenu": [
      "com.strefiz.slimechunkhud.screen.ModMenuIntegration"
    ]
  },

  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*"
  },

  "suggests": {
    "modmenu": "*"
  },

  "custom": {
    "modmenu:screen": {
      "class": "com.strefiz.slimechunkhud.screen.ModMenuScreenFactory"
    }
  }
}
